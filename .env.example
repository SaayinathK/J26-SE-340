# Copy to .env and edit. Nothing here is a secret by default; the JWT secret MUST be changed outside dev.
APP_ENV=dev
# Auth: in dev you may send X-Dev-Tenant / X-Dev-Roles headers instead of a JWT.
ALLOW_DEV_AUTH=true
JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256

# Storage (SQLite): one tenant-isolated DB and one separate shared-insights DB.
TENANT_DB_PATH=data/tenant.sqlite
SHARED_DB_PATH=data/shared.sqlite

# Generator: "auto" tries the local LLM then falls back to the template generator; "template" never loads a model.
GENERATOR_BACKEND=auto
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
RAG_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_VERSION=prototype-v1
ADAPTER_ID=none
# Path to a fine-tuned LoRA adapter (from training/sft_qlora.py or dpo.py). Empty = base model only.
ADAPTER_PATH=
# 4-bit loading (NVIDIA GPU + bitsandbytes). Needed to serve or evaluate a 7B model on a 16 GB GPU.
LLM_LOAD_4BIT=false
# Production base model is mistralai/Mistral-7B-Instruct-v0.3 (needs a GPU); the CPU prototype default is Qwen2.5-1.5B-Instruct.
EXPERIMENT_LOG_PATH=experiments/runs.jsonl

# Privacy
K_ANONYMITY=5
LAPLACE_EPSILON=1.0
ENABLE_LAPLACE_NOISE=false

# Ranking weights: score = w1*confidence + w2*uplift_similarity + w3*constraint_fit + w4*shared_support
RANK_W_CONFIDENCE=0.30
RANK_W_UPLIFT=0.30
RANK_W_CONSTRAINT=0.25
RANK_W_SHARED=0.15

# Reward weights: reward = a*outcome_uplift + b*explicit_feedback
REWARD_W_OUTCOME=0.6
REWARD_W_FEEDBACK=0.4
