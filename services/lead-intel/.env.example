# services/lead-intel/.env.example — settings of the C3 service (all optional; defaults shown)
# Docker sets these in docker-compose.yml. For a local run, set them in PowerShell, e.g.  $env:C3_PORT="4003"

# History storage: leave empty to use JSON-lines files in services/lead-intel/state/
# Docker database (port 5436 on your laptop):
# C3_DATABASE_URL=postgresql://lead_intel_app:c3_local_dev_only_2026@127.0.0.1:5436/lead_intel
C3_DATABASE_URL=

# Model server (Ollama). Host Ollama: http://127.0.0.1:11434  |  Docker model container: http://127.0.0.1:11437
OLLAMA_URL=http://127.0.0.1:11434
C3_LLM_MODEL=c3-mistral-ft
C3_EMBED_MODEL=nomic-embed-text
C3_RETRIEVAL=hybrid
C3_PORT=4003

# Paths (only change them if your files are somewhere else)
# C3_MODEL_PATH=../../ml/models/lead-intel/lead_scorer.joblib
# C3_LEADS_PATH=../../ml/lead-intel/data/processed/leads_ghl.jsonl
# C3_KB_DIR=../../ml/lead-intel/data/processed/kb
# C3_REPORTS_DIR=../../docs/evidence/lead-intel/reports
