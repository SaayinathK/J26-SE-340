node_modules/
.env
.env.*
!.env.example

.venv/
__pycache__/
*.pyc
# ML data and model files (team folder structure)
ml/models/
ml/*/data/raw/*
!ml/lead-intel/data/raw/business_context/
ml/*/data/processed/
