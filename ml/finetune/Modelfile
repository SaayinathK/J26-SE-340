# ml/finetune/Modelfile — run the fine-tuned C4 Email Agent model in Ollama
# 1. Unzip c4-email-lora.zip (downloaded from Colab / Google Drive) into ./models/c4-email-lora/
#    The folder must contain adapter_config.json and adapter_model.safetensors.
# 2. ollama pull mistral:7b-instruct-v0.3-q4_K_M      (same base version the adapter was trained on)
# 3. ollama create c4-email-ft -f Modelfile
# 4. In services/gateway/.env set OLLAMA_MODEL=c4-email-ft
FROM mistral:7b-instruct-v0.3-q4_K_M
ADAPTER ./models/c4-email-lora
PARAMETER temperature 0.3
PARAMETER num_predict 700
PARAMETER num_ctx 4096
